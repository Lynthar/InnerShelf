# Copy to .env.local and fill in real values. .env.local is gitignored.
#
# Stash GraphQL endpoint base URL (no trailing slash).
# Local dev compose default is http://localhost:9999
VITE_STASH_URL=http://localhost:9999

# Stash API Key (Settings → Security → Generate API Key in Stash native UI :9999).
# Required for graphql-codegen and for the dev client to authenticate.
# DO NOT commit a real key. Production frontend reads the key from localStorage,
# entered by the user on the login page; this env var is for local development only.
VITE_STASH_API_KEY=
